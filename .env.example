# Copy to .env and fill in. Never commit .env.

# HTTP listen port (Dokploy should route ynab.mazlabs.com to this port).
PORT=8080

# YNAB Personal Access Token. Used only on the server to call https://api.ynab.com/v1.
# Create one at https://app.ynab.com/settings/developer
# YNAB_ACCESS_TOKEN is accepted as an alias.
YNAB_API_KEY=

# Shared bearer secret Cursor (and other MCP clients) must send.
# Generate with: openssl rand -hex 32
# MCP_BEARER_TOKEN is accepted as an alias. Minimum 16 characters.
MCP_AUTH_TOKEN=

# Optional default plan id. Tools can still pass plan_id, "last-used", or "default".
# YNAB_PLAN_ID=

# Optional overrides.
# YNAB_API_BASE=https://api.ynab.com/v1
# YNAB_CACHE_TTL_SECONDS=30
# YNAB_MAX_REQUESTS_PER_HOUR=180
# Comma-separated Host values allowed to call /mcp. An entry without a port matches any port.
# MCP_ALLOWED_HOSTS=localhost,127.0.0.1,::1,ynab.mazlabs.com
# RUST_LOG=info
